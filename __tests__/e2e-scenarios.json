{
  "include": [
    {
      "name": "node-pnpm",
      "working-directory": "__tests__/fixtures/node-pnpm",
      "fail-on-unknown": true,
      "expected": {
        "language": "node",
        "version": "1.2.3",
        "package-manager": "pnpm",
        "package-manager-version": "9.12.0",
        "language-version": "20.18.0",
        "language-version-file": "__tests__/fixtures/node-pnpm/.nvmrc",
        "version-major": "1",
        "is-prerelease": "false",
        "workspace-root": "__tests__/fixtures/node-pnpm",
        "install-command": "pnpm install --frozen-lockfile",
        "cache-dependency-path": "__tests__/fixtures/node-pnpm/pnpm-lock.yaml",
        "projects": "[]"
      }
    },
    {
      "name": "python-poetry",
      "working-directory": "__tests__/fixtures/python-poetry",
      "fail-on-unknown": true,
      "expected": {
        "language": "python",
        "version": "4.5.6",
        "package-manager": "poetry",
        "package-manager-version": "1.8.4",
        "language-version": "^3.11",
        "language-version-source": "pyproject.toml:tool.poetry.dependencies.python",
        "language-version-file": "__tests__/fixtures/python-poetry/pyproject.toml",
        "install-command": "poetry install",
        "cache-dependency-path": "__tests__/fixtures/python-poetry/poetry.lock"
      }
    },
    {
      "name": "go-module",
      "working-directory": "__tests__/fixtures/go-module",
      "fail-on-unknown": true,
      "expected": {
        "language": "go",
        "version": "7.8.9",
        "package-manager": "go",
        "package-manager-version": "1.22.7",
        "language-version": "1.22.0",
        "language-version-file": "__tests__/fixtures/go-module/go.mod",
        "install-command": "go mod download",
        "cache-dependency-path": "__tests__/fixtures/go-module/go.sum"
      }
    },
    {
      "name": "node workspace member",
      "working-directory": "__tests__/fixtures/node-workspace/apps/api",
      "fail-on-unknown": true,
      "expected": {
        "language": "node",
        "version": "2.1.0-rc.1",
        "version-major": "2",
        "version-minor": "1",
        "version-patch": "0",
        "version-prerelease": "rc.1",
        "is-prerelease": "true",
        "package-manager": "pnpm",
        "package-manager-version": "10.4.1",
        "language-version": "22.11.0",
        "language-version-source": "../../.nvmrc",
        "language-version-file": "__tests__/fixtures/node-workspace/.nvmrc",
        "lockfile": "../../pnpm-lock.yaml",
        "workspace-root": "__tests__/fixtures/node-workspace",
        "install-command": "pnpm install --frozen-lockfile",
        "cache-dependency-path": "__tests__/fixtures/node-workspace/pnpm-lock.yaml"
      }
    },
    {
      "name": "rust workspace member",
      "working-directory": "__tests__/fixtures/rust-workspace/crates/cli",
      "fail-on-unknown": true,
      "expected": {
        "language": "rust",
        "name": "fixture-cli",
        "version": "3.1.0",
        "version-source": "../../Cargo.toml:workspace.package.version",
        "package-manager": "cargo",
        "language-version": "1.85.0",
        "language-version-source": "../../rust-toolchain.toml:toolchain.channel",
        "language-version-file": "__tests__/fixtures/rust-workspace/rust-toolchain.toml",
        "lockfile": "../../Cargo.lock",
        "workspace-root": "__tests__/fixtures/rust-workspace",
        "install-command": "cargo fetch --locked",
        "cache-dependency-path": "__tests__/fixtures/rust-workspace/Cargo.lock"
      }
    },
    {
      "name": "flutter app",
      "working-directory": "__tests__/fixtures/flutter-app",
      "fail-on-unknown": true,
      "expected": {
        "language": "dart",
        "name": "fixture_flutter",
        "version": "1.4.0+27",
        "version-major": "1",
        "version-build": "27",
        "is-prerelease": "false",
        "package-manager": "flutter",
        "language-version": "3.27.1",
        "language-version-source": ".fvmrc:flutter",
        "language-version-file": "__tests__/fixtures/flutter-app/.fvmrc",
        "lockfile": "pubspec.lock",
        "install-command": "flutter pub get --enforce-lockfile",
        "cache-dependency-path": "__tests__/fixtures/flutter-app/pubspec.lock"
      }
    },
    {
      "name": "discover a rust workspace",
      "working-directory": "__tests__/fixtures/rust-workspace",
      "discover": true,
      "expected": {
        "language": "rust",
        "version": "3.1.0",
        "projects": "[\"__tests__/fixtures/rust-workspace\",\"__tests__/fixtures/rust-workspace/crates/cli\"]"
      }
    },
    {
      "name": "discover a workspace",
      "working-directory": "__tests__/fixtures/node-workspace",
      "discover": true,
      "fail-on-unknown": true,
      "expected": {
        "language": "node",
        "name": "fixture-workspace",
        "projects": "[\"__tests__/fixtures/node-workspace\",\"__tests__/fixtures/node-workspace/apps/api\"]"
      }
    },
    {
      "name": "discover, max depth 0",
      "working-directory": "__tests__/fixtures/node-workspace",
      "discover": true,
      "discover-max-depth": "0",
      "expected": {
        "projects": "[\"__tests__/fixtures/node-workspace\"]"
      }
    },
    {
      "name": "mixed, auto",
      "working-directory": "__tests__/fixtures/mixed",
      "expected": {
        "language": "node",
        "languages": "[\"node\",\"go\"]"
      }
    },
    {
      "name": "mixed, forced go",
      "working-directory": "__tests__/fixtures/mixed",
      "language": "go",
      "expected": {
        "language": "go",
        "name": "example.com/mixed"
      }
    },
    {
      "name": "mixed, language-priority go",
      "working-directory": "__tests__/fixtures/mixed",
      "language-priority": "go",
      "expected": {
        "language": "go",
        "languages": "[\"go\",\"node\"]"
      }
    },
    {
      "name": "unknown",
      "working-directory": ".github",
      "expected": {
        "language": "unknown"
      }
    },
    {
      "name": "unknown, fail-on-unknown",
      "working-directory": ".github",
      "fail-on-unknown": true,
      "expect-failure": true,
      "expected": {
        "language": "unknown"
      }
    },
    {
      "name": "missing working-directory",
      "working-directory": "does-not-exist",
      "expect-failure": true,
      "expected": {}
    },
    {
      "name": "invalid discover-max-depth",
      "working-directory": ".",
      "discover": true,
      "discover-max-depth": "deep",
      "expect-failure": true,
      "expected": {}
    }
  ]
}
