# Used by `bun run local-action` (@github/local-action) to run the action without pushing to GitHub.
# Copy to `.env` and adjust. Inputs are exposed as INPUT_<name>.
INPUT_WORKING-DIRECTORY=.
INPUT_LANGUAGE=auto
INPUT_LANGUAGE-PRIORITY=
INPUT_TAG-PATTERN=
INPUT_DISCOVER=false
INPUT_DISCOVER-MAX-DEPTH=3
INPUT_DISCOVER-EXCLUDE=
INPUT_FAIL-ON-UNKNOWN=false
# Optional: where to write the job summary (omit to skip it).
# GITHUB_STEP_SUMMARY=/tmp/step-summary.md
