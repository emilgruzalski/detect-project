{
  "name": "detect-project-action",
  "version": "1.0.0",
  "private": true,
  "description": "GitHub Action that detects the project's language, application version and package manager (Node, Python, Go)",
  "type": "module",
  "exports": {
    ".": "./dist/index.js"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "package": "rimraf dist && rollup --config rollup.config.ts --configPlugin @rollup/plugin-typescript",
    "package:watch": "npm run package -- --watch",
    "local-action": "local-action . src/main.ts .env",
    "all": "npm run typecheck && npm run test && npm run package"
  },
  "dependencies": {
    "@actions/core": "^3.0.1",
    "@actions/exec": "^3.0.0",
    "smol-toml": "^1.8.0"
  },
  "devDependencies": {
    "@github/local-action": "^7.0.1",
    "@rollup/plugin-commonjs": "^29.0.3",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-typescript": "^12.3.0",
    "@types/node": "^26.5.1",
    "rimraf": "^6.0.1",
    "rollup": "^4.63.3",
    "tslib": "^2.8.1",
    "typescript": "^7.0.2",
    "vitest": "^5.0.0"
  },
  "license": "Apache-2.0"
}
